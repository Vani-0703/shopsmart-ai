# ==============================
# ShopSmart AI - Frontend Env Vars
# Copy this file to ".env" and fill in real values.
# All Vite env vars MUST be prefixed with VITE_ to be exposed to the browser.
# NEVER put secret keys here — only publishable/public keys.
# ==============================

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# Firebase (Web SDK config — from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Stripe publishable key (test mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Socket.io server URL (defaults to VITE_API_URL host if omitted)
VITE_SOCKET_URL=http://localhost:5000
